+package supermarktsimulator.view;
+
+import supermarktsimulator.model.Klant;
+import javax.imageio.ImageIO;
+import javax.swing.*;
+import java.awt.*;
+import java.awt.event.ActionEvent;
+import java.awt.event.ActionListener;
+import java.awt.image.BufferedImage;
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+
+public class SupermarketPanel extends JPanel implements ActionListener {
+
+    private BufferedImage tileset;
+    private int[][] map;
+    private final int tileSize = 32;
+
+    private Timer timer;
+    private List<Klant> klanten;
+
+    public SupermarketPanel() {
+        try {
+            tileset = ImageIO.read(Objects.requireNonNull(getClass().getResource("/FlorisIsCool.png")));
+            map = loadMap("/tilemap.txt");
+        } catch (IOException | NullPointerException e) {
+            System.err.println("Kon de tilemap of tileset niet laden! Controleer of de bestanden in de 'resources' map staan.");
+            e.printStackTrace();
+            map = new int[1][1];
+        }
+
+        klanten = new ArrayList<>();
+        maakKlantenAan();
+
+        timer = new Timer(16, this);
+        timer.start();
+    }
+
+    /**
+     * Maakt een klant aan met een route die correct is voor de gegeven tilemap.
+     * De klant loopt netjes door de gangpaden (waar de tegel '0' is),
+     * gaat naar de kassa en verlaat de winkel.
+     */
+    private void maakKlantenAan() {
+        // Een correcte en logische route gebaseerd op de tilemap.
+        List<Point> klantRoute = Arrays.asList(
+                // Stap 1: Winkel binnenkomen
+                new Point(4 * tileSize, 22 * tileSize),  // Start buiten de deur
+                new Point(4 * tileSize, 19 * tileSize),  // Loop door de deur naar binnen op het hoofdpad
+
+                // Stap 2: Boodschappen doen in de gangpaden
+                new Point(7 * tileSize, 19 * tileSize),  // Loop naar het eerste gangpad (rechts)
+                new Point(7 * tileSize, 6 * tileSize),   // Loop het gangpad omhoog (langs schappen 3 en 5)
+                new Point(19 * tileSize, 6 * tileSize),  // Loop door het bovenste gangpad naar rechts (langs schappen 3 en 4)
+                new Point(19 * tileSize, 10 * tileSize), // Loop het rechter gangpad een stukje omlaag
+                new Point(12 * tileSize, 10 * tileSize), // Loop door een middengangpad naar links
+                new Point(12 * tileSize, 14 * tileSize), // Loop een ander gangpad omlaag
+
+                // Stap 3: Naar de kassa gaan
+                new Point(12 * tileSize, 19 * tileSize), // Loop naar het hoofdgangpad onderaan
+                new Point(15 * tileSize, 19 * tileSize), // Loop naar een kassa (nummer 6 op de kaart staat op y=18)
+
+                // Stap 4: Winkel verlaten
+                new Point(4 * tileSize, 19 * tileSize),  // Loop terug richting de uitgang
+                new Point(4 * tileSize, 22 * tileSize)   // Loop naar buiten en verlaat het scherm
+        );
+
+        // Maak de klant aan met deze nieuwe, correcte route
+        Klant nieuweKlant = new Klant(klantRoute.get(0).x, klantRoute.get(0).y, klantRoute);
+        klanten.add(nieuweKlant);
+    }
+
+    @Override
+    public void actionPerformed(ActionEvent e) {
+        updateSimulatie();
+        repaint();
+    }
+
+    private void updateSimulatie() {
+        for (Klant klant : klanten) {
+            klant.update();
+        }
+    }
+
+    private int[][] loadMap(String path) throws IOException {
+        try (BufferedReader reader = new BufferedReader(
+                new InputStreamReader(Objects.requireNonNull(getClass().getResourceAsStream(path))))) {
+
+            return reader.lines()
+                    .map(line -> line.trim().split(" +"))
+                    .map(arr -> Arrays.stream(arr)
+                            .mapToInt(Integer::parseInt)
+                            .toArray())
+                    .toArray(int[][]::new);
+        }
+    }
+
+    @Override
+    protected void paintComponent(Graphics g) {
+        super.paintComponent(g);
+
+        if (tileset == null || map == null) {
+            g.setColor(Color.RED);
+            g.drawString("Kon resources niet laden!", 10, 20);
+            return;
+        }
+
+        int tilesPerRow = tileset.getWidth() / tileSize;
+        for (int y = 0; y < map.length; y++) {
+            for (int x = 0; x < map[y].length; x++) {
+                int tileIndex = map[y][x];
+                int tileX = (tileIndex % tilesPerRow) * tileSize;
+                int tileY = (tileIndex / tilesPerRow) * tileSize;
+                BufferedImage tile = tileset.getSubimage(tileX, tileY, tileSize, tileSize);
+                g.drawImage(tile, x * tileSize, y * tileSize, null);
+            }
+        }
+
+        for (Klant klant : klanten) {
+            klant.draw(g);
+        }
+    }
+}
