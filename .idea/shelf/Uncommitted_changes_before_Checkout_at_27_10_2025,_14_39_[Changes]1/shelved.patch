@@ -0,0 +1,36 @@
+package supermarktsimulator;
+
+import supermarktsimulator.view.SupermarketPanel;
+
+import javax.swing.*;
+import java.awt.*;
+
+/**
+ * Dit is de hoofdklasse van de applicatie.
+ * Zijn enige taak is het opzetten van het venster (JFrame)
+ * en het toevoegen van ons SupermarketPanel waar de simulatie draait.
+ */
+public class SupermarktSimulator {
+
+    public static void main(String[] args) {
+        // Swing applicaties moeten op de 'Event Dispatch Thread' (EDT) worden gestart.
+        // SwingUtilities.invokeLater zorgt daarvoor.
+        SwingUtilities.invokeLater(() -> {
+            // Maak het hoofdvenster van de applicatie.
+            JFrame frame = new JFrame("🛒 Supermarkt Simulator");
+            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
+
+            // Maak een instantie van ons SupermarketPanel.
+            SupermarketPanel panel = new SupermarketPanel();
+            frame.add(panel);
+
+            // Zorg ervoor dat het venster groot genoeg is voor de tilemap.
+            // Dit is een simpele manier, je kunt het ook dynamisch berekenen.
+            frame.setPreferredSize(new Dimension(1600, 900));
+            frame.pack(); // Past de grootte van het frame aan aan de inhoud.
+
+            frame.setLocationRelativeTo(null); // Centreer het venster.
+            frame.setVisible(true); // Maak het venster zichtbaar.
+        });
+    }
+}
