+package supermarktsimulator.model;
+
+import java.awt.Graphics; // Nodig voor het 'Graphics' object
+
+/**
+ * Dit is een 'abstracte' basisklasse voor alle personen in de simulatie.
+ * Abstract betekent dat je geen 'Persoon' direct kunt aanmaken, alleen subklassen zoals Klant of Vakkenvuller.
+ * Het bevat de eigenschappen die alle personen gemeen hebben, zoals hun positie.
+ */
+public abstract class Persoon {
+
+    // De positie van de persoon op het scherm.
+    // 'protected' betekent dat deze variabelen toegankelijk zijn in deze klasse én in alle subklassen (zoals Klant).
+    protected double x;
+    protected double y;
+
+    /**
+     * Constructor om een persoon op een startpositie te plaatsen.
+     * @param startX De x-coördinaat waar de persoon begint.
+     * @param startY De y-coördinaat waar de persoon begint.
+     */
+    public Persoon(double startX, double startY) {
+        this.x = startX;
+        this.y = startY;
+    }
+
+    /**
+     * Update de logica van de persoon, zoals beweging.
+     * Deze methode wordt elke 'tick' van de simulatie aangeroepen.
+     */
+    public abstract void update();
+
+    /**
+     * Tekent de persoon op het scherm.
+     * @param g Het Graphics object waarmee getekend wordt.
+     */
+    public abstract void draw(Graphics g);
+}
