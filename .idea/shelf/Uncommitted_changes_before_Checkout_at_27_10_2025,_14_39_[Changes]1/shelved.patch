+package supermarktsimulator.model;
+
+// --- BELANGRIJK: Alle benodigde imports ---
+import javax.imageio.ImageIO;
+import java.awt.Color; // Nodig voor het tekenen van een alternatieve cirkel
+import java.awt.Graphics;
+import java.awt.Point; // Nodig voor de route-coördinaten
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.util.List; // Nodig voor de lijst van punten
+import java.util.Objects;
+// --- Einde van de imports ---
+
+/**
+ * De Klant klasse representeert een klant in de supermarkt.
+ * Een klant erft van Persoon en heeft dus een x- en y-positie.
+ * Daarnaast heeft een klant een route die hij volgt.
+ */
+public class Klant extends Persoon { // 'extends Persoon' erft de x en y variabelen
+
+    private BufferedImage sprite;
+    private List<Point> route;
+    private int huidigDoelIndex;
+    private final double snelheid = 2.0;
+
+    /**
+     * Constructor om een nieuwe klant te maken.
+     * @param startX De x-positie waar de klant begint.
+     * @param startY De y-positie waar de klant begint.
+     * @param route De route die de klant zal volgen.
+     */
+    public Klant(double startX, double startY, List<Point> route) {
+        // 'super()' roept de constructor van de bovenliggende klasse (Persoon) aan.
+        super(startX, startY);
+        this.route = route;
+        this.huidigDoelIndex = 0;
+
+        try {
+            sprite = ImageIO.read(Objects.requireNonNull(getClass().getResource("/klant.png")));
+        } catch (IOException | NullPointerException e) {
+            System.err.println("Afbeelding voor klant niet gevonden! Zorg dat 'klant.png' in de resources map staat.");
+            sprite = null; // Zorg ervoor dat sprite null is als het laden mislukt
+        }
+    }
+
+    /**
+     * Deze methode wordt continu aangeroepen om de klant te laten bewegen.
+     */
+    @Override // Deze annotatie geeft aan dat we een methode van de superklasse overschrijven.
+    public void update() {
+        if (route == null || route.isEmpty() || huidigDoelIndex >= route.size()) {
+            return;
+        }
+
+        Point doel = route.get(huidigDoelIndex);
+        double dx = doel.x - this.x; // 'this.x' komt uit de Persoon klasse
+        double dy = doel.y - this.y; // 'this.y' komt uit de Persoon klasse
+        double afstand = Math.sqrt(dx * dx + dy * dy);
+
+        if (afstand < snelheid) {
+            huidigDoelIndex++;
+        } else {
+            this.x += (dx / afstand) * snelheid;
+            this.y += (dy / afstand) * snelheid;
+        }
+    }
+
+    /**
+     * Tekent de klant op zijn huidige positie.
+     */
+    @Override // Ook deze methode komt uit Persoon.
+    public void draw(Graphics g) {
+        if (sprite != null) {
+            g.drawImage(sprite, (int) x, (int) y, null);
+        } else {
+            // Als de afbeelding niet is geladen, teken een simpele blauwe cirkel.
+            g.setColor(Color.BLUE);
+            g.fillOval((int) x, (int) y, 32, 32);
+        }
+    }
+}
